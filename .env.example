# ─────────────────────────────────────────────────────────────────────────────
# .env.example — NOMBRES de las variables. Nunca valores.
#
# Este archivo es la lista de lo que hay que cargar, no dónde cargarlo. El
# valor real de cada una va en Vercel → Project → Settings → Environment
# Variables, y lo pega Mauro a mano. Ningún chat pide ni carga un valor: ver
# GESTOS.md y PROTOCOLO-SECRETOS.md del repo privado `datos`.
#
# Un .env con valores reales NUNCA se commitea. El .gitignore ya lo bloquea,
# pero el historial de git es permanente y borrarlo después no alcanza.
# ─────────────────────────────────────────────────────────────────────────────

# Access ID de la app creada en Tuya IoT Platform (Cloud → Development).
TUYA_CLIENT_ID=

# Access Secret de esa misma app. Es un secreto de verdad: sólo en Vercel.
TUYA_CLIENT_SECRET=

# Centro de datos donde está la cuenta: us | eu | cn | in  (por defecto: us)
TUYA_REGION=

# Los dispositivos que la página puede tocar, como JSON en una sola línea.
# El alias es lo único que viaja desde el navegador; el identificador real del
# dispositivo se queda del lado del servidor.
#
#   forma corta:  {"luz":"IDENTIFICADOR"}                       → comando switch_1
#   forma larga:  {"luz":{"id":"IDENTIFICADOR","comando":"switch_1",
#                         "comandos":["switch_1"],"min":10,"max":1000}}
#
# Sin la lista "comandos", el ÚNICO comando permitido es el declarado en
# "comando": un alias no habilita mandarle cualquier cosa al aparato.
TUYA_DISPOSITIVOS=

# Frase compartida entre la página y la función. Sin ella la función no hace
# nada — ni siquiera el diagnóstico. La dirección /api/tuya es pública como
# todo lo que publica Vercel, así que esto es lo que separa "puerta cerrada"
# de "no hay puerta". Se escribe una vez en el teléfono, en la propia página,
# y queda en su localStorage.
HARMONIA_CLAVE=
